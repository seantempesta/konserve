(ns konserve.jolt.lmdb-test
  "The LMDB store (Jolt only): konserve's compliance suite, and its transactions: an append
  is one write transaction (PTransactBackingStore), and a transaction that throws leaves
  nothing behind."
  (:require [clojure.java.shell]
            [clojure.test :refer [deftest is testing]]
            [konserve.core :as k]
            [konserve.compliance-test :refer [compliance-test]]
            [konserve.impl.defaults]
            [konserve.impl.storage-layout :as sl]
            [konserve.jolt.filestore :as jfs]
            [konserve.jolt.lmdb :as lmdb]
            [konserve.jolt.posix :as p]
            [hasch.benc]
            [hasch.core]
            [hasch.platform]))

(defn- with-store [f]
  (let [path (str (System/getProperty "java.io.tmpdir") "/konserve-lmdb-test-" (random-uuid))
        store (lmdb/connect-lmdb-store path :opts {:sync? true})]
    (try (f store) (finally (lmdb/close-env! path) (clojure.java.shell/sh "rm" "-rf" path)))))

(deftest lmdb-compliance
  (with-store compliance-test))

(deftest an-append-is-one-transaction
  (with-store
    (fn [store]
      (is (satisfies? sl/PTransactBackingStore (:backing store)))
      (k/append store :log 1 {:sync? true})
      (testing "a transaction that throws after an append leaves the log as it was"
        (is (thrown? Exception
                     (sl/-transact (:backing store)
                                   (fn [] (k/append store :log 2 {:sync? true}) (throw (ex-info "stop" {}))))))
        (is (= [1] (k/log store :log {:sync? true}))))
      (testing "inside one transaction several appends commit together"
        (sl/-transact (:backing store) (fn [] (k/append store :log 2 {:sync? true}) (k/append store :log 3 {:sync? true})))
        (is (= [1 2 3] (k/log store :log {:sync? true}))))
      (testing "async appends too"
        (is (= [1 2 3 4] (do (clojure.core.async/<!! (k/append store :log 4 {:sync? false}))
                             (k/log store :log {:sync? true}))))))))

(deftest a-connect-in-the-canonical-shape-warns-of-nothing
  ;; konserve.impl.defaults/normalize-store-config logs each old spelling it is handed. Our
  ;; stores' own defaults are none of them, so a caller who names nothing, or names its
  ;; encoding under :config :encoding, is warned of nothing; the old spelling still is.
  (let [seen (atom [])
        tmp #(str (System/getProperty "java.io.tmpdir") "/konserve-canon-test-" (random-uuid))
        lmdb! (fn [& params] (let [path (tmp)]
                               (try (apply lmdb/connect-lmdb-store path :opts {:sync? true} params)
                                    (finally (lmdb/close-env! path) (clojure.java.shell/sh "rm" "-rf" path)))))
        fs! (fn [& params] (let [path (tmp)]
                             (try (apply jfs/connect-fs-store path :opts {:sync? true} params)
                                  (finally (clojure.java.shell/sh "rm" "-rf" path)))))]
    (with-redefs [konserve.impl.defaults/deprecated! (fn [from _] (swap! seen conj from))]
      (lmdb!) (fs!)
      (lmdb! :config {:encoding {:serializer :StringSerializer :compressor {:type :lz4}}})
      (fs! :config {:encoding {:serializer :StringSerializer}})
      (is (= [] @seen))
      (lmdb! :default-serializer :StringSerializer)
      (is (= [:default-serializer] @seen)))))

(deftest a-directory-to-delete-has-its-envs-closed
  ;; close-envs-under! closes the envs at and under a directory and no other
  (let [base (str (System/getProperty "java.io.tmpdir") "/konserve-under-test-" (random-uuid))
        a (str base "/a") b (str base "/b/c") other (str base "-other")]
    (try
      (doseq [path [a b other]] (lmdb/connect-lmdb-store path :opts {:sync? true}))
      (is (= #{a b} (set (lmdb/close-envs-under! (str base "/")))))
      (is (= [] (lmdb/close-envs-under! base)) "closed already")
      (is (= [other] (lmdb/close-envs-under! other)))
      (finally (doseq [path [a b other]] (lmdb/close-env! path))
               (clojure.java.shell/sh "rm" "-rf" base other)))))

(defn- store-key-by-hasch
  "key->store-key as it was before its digest was one libcrypto call: hasch's
  coercion, a MessageDigest, then uuid5. The reference the new one must equal."
  [key]
  (str (hasch.platform/uuid5 (hasch.benc/digest (hasch.benc/-coerce key hasch.platform/sha512-message-digest {})
                                                hasch.platform/sha512-message-digest))
       ".ksv"))

(defn- varied-keys
  "200 keys of the shapes stores are handed: Datahike's node, commit and value
  addresses (uuids), branch heads and its own keys (keywords), commit-graph keys
  ([:datahike/commit-graph cid]), and the rest of what hasch encodes."
  []
  (let [r (java.util.Random. 7)
        uuid #(java.util.UUID. (.nextLong r) (.nextLong r))
        kw #(keyword (str "k" (.nextInt r 1000)))
        qkw #(keyword (str "datahike." (.nextInt r 50)) (str "n" (.nextInt r 1000)))
        s #(apply str (repeatedly (.nextInt r 40) (fn [] (char (+ 1 (.nextInt r 200))))))]
    (concat (repeatedly 50 uuid)
            [:db :main :branches :datahike/collection :konserve/gc]
            (repeatedly 15 kw)
            (repeatedly 15 qkw)
            (repeatedly 30 (fn [] [:datahike/commit-graph (uuid)]))
            (repeatedly 10 (fn [] (vec (repeatedly (.nextInt r 4) uuid))))
            (repeatedly 15 s)
            [(apply str (repeat 1100 "x")) "" "\u0001\u001d" "naïve ✓"]
            (repeatedly 10 #(.nextLong r))
            (repeatedly 5 #(.nextDouble r))
            [nil true false 'sym 'ns/sym (java.util.Date. 0) [] () '(:a 1) [[:a [1 (uuid)]]]
             {:a 1 :b [2 3]} #{:x :y (uuid)} {} #{} (byte-array [1 2 3])
             (list* (repeatedly 3 uuid)) {:branch :main :id (uuid)}]
            (repeatedly 24 (fn [] {(kw) (uuid)})))))

(deftest a-store-key-is-the-hasch-uuid-of-its-key
  ;; one SHA-512 call names the same file as hasch's MessageDigest did, byte for
  ;; byte, so a store written before reads after and the reverse
  (let [ks (varied-keys)]
    (is (= 200 (count ks)))
    (is (= [] (vec (keep (fn [k] (let [old (store-key-by-hasch k) new (konserve.impl.defaults/key->store-key k)]
                                   (when (not= old new) [k old new])))
                         ks))))
    (testing "and upstream's definition, hasch.core/uuid's"
      (is (= [] (vec (keep (fn [k] (let [up (str (hasch.core/uuid k) ".ksv") new (konserve.impl.defaults/key->store-key k)]
                                     (when (not= up new) [k up new])))
                           ks)))))))
