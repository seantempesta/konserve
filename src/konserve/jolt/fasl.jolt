(ns konserve.jolt.fasl
  "jfasl: Jolt values <-> bytes in a tagged, versioned format that names each value by its
  meaning, never by the runtime's record layouts, so bytes written by one Jolt/Chez build read
  in another (src/konserve/jolt/jfasl.ss has the format). encode answers a byte-array sharing
  the encoded bytevector."
  (:require [jolt.scheme :as s] [clojure.java.io :as io]))

(defmacro ^:private scheme-source [] (slurp (or (io/resource "konserve/jolt/jfasl.ss") "src/konserve/jolt/jfasl.ss")))
;; the Scheme text is read at compile time, so a built binary carries it
(defonce ^:private loaded (s/eval-string (str "(begin " (scheme-source) ")")))

(def ^:private enc (s/proc "kjc-encode"))
(def ^:private dec (s/proc "kjc-decode"))
(def ^:private bv->ba (s/proc "kjc-bv->ba"))
(def ^:private ba->bv (s/proc "kjc-ba->bv"))
(def ^:private reg! (s/proc "kjc-register-handler!"))

(defn encode-bv "v as jfasl bytes in a bytevector (a host value)." [v] (enc v))
(defn decode-bv "The value in a jfasl bytevector." [bv] (dec bv))
(defn encode "v as a byte-array." ^bytes [v] (bv->ba (enc v)))
(defn decode "The value in a byte-array from encode." [^bytes b] (dec (ba->bv b)))
(defn bv-length [bv] (s/call "bytevector-length" bv))
(def ^:private tag-of (s/eval-string "(lambda (x) (jrdesc-tag (jrec-desc x)))"))
(defn type-tag "The runtime's type tag of a deftype/defrecord instance." [x] (tag-of x))
(def ^:private jrec?* (s/eval-string "(lambda (x) (jrec? x))"))
(defn jrec? "Is x a deftype/defrecord instance?" [x] (jrec?* x))

(defn register-handler!
  "Instances of the deftype/defrecord with this type tag (type-tag) travel as (dump x), any
  encodable value, and come back as (restore data). Register the same tag, dump and restore in
  every process that reads or writes them."
  [tag dump restore] (reg! tag dump restore))
