;; jfasl: Jolt values <-> bytes in a tagged format that names every value by its
;; meaning, never by the runtime's record layout. A store written by one Jolt/Chez
;; build reads in another: nothing of a collection's trie, a keyword's hash or a
;; record's slot layout is written. (The first jfasl wrote raw Chez fasl with the rtds
;; omitted, so a store stopped reading when a layout's nongenerative tag changed:
;; "unregistered record type chez-juuid-v1".)
;;
;; Layout: #x4A #x01 (magic "J", format version 1), then one value. Each value is a tag
;; byte and its payload; counts and lengths are unsigned LEB128 varints.
;;
;;   0 nil   1 true   2 false
;;   3 integer in [-2^63, 2^63): zigzag varint     4 other integer: sign byte, length, magnitude (big-endian)
;;   5 double: 8 bytes IEEE big-endian             6 float: 4 bytes IEEE big-endian
;;   7 ratio: numerator value, denominator value   8 bigdec: unscaled value, scale value
;;   9 char: code point varint                     10 string: UTF-8 length, bytes
;;  11 keyword  13 symbol: a name reference (below), then for a new name: has-ns byte, [ns], name
;;  15 vector: n, n values      16 map entry: key, value
;;  17 array map: n, n keys and values in iteration order (comes back an array map, same order)
;;  18 hash map: n, n keys and values                     19 set: n, n values
;;  20 list (any seq, forced): values until 21          22 uuid: 16 bytes (the two halves, big-endian)
;;  23 inst: zigzag varint of epoch ms                   24 tagged literal: tag value, form value
;;  25 byte array: length, bytes
;;  26 deftype/defrecord instance: a name reference to its type (new: the tag string and the field
;;     count), then the fields in declared order and the extension map (nil when none)
;;  27 an instance of a type with a registered handler: name reference, (new) the tag string,
;;     then (dump x)
;;  28 metadata: the meta value, then the value it is attached to (vector, map, set, list, symbol)
;;
;; A name reference is a varint i: 0 introduces a new name (its strings follow and it takes the
;; next index); i > 0 repeats name i-1. Keywords, symbols and type tags share the per-message
;; table, so a keyword or a record type costs one or two bytes after its first occurrence.
;;
;; Named dragons:
;; - A deftype's fields travel as the runtime holds them, cached hashes included (Datahike's
;;   Datom keeps its hash in a field). That hash is Clojure's specified hash of the other fields,
;;   so it is the same in every build that implements Clojure's hash.
;; - A seq comes back a list; a lazy seq is forced. Sorted collections, functions, atoms and
;;   other reference types have no encoding and raise an error naming the type.

;; handlers by type tag: tag -> (dump . restore)
(define kjc-handlers (make-hashtable string-hash string=?))
(define (kjc-register-handler! tag dump restore)
  (hashtable-set! kjc-handlers tag (cons dump restore)))

(define kjc-version 1)

(define (kjc-no-encoding x)
  (error 'konserve.jolt.fasl "no stable encoding for a value of this type" (jolt-class-name x)))

(define (kjc-encode v)
  (let ((buf (make-bytevector 256)) (pos 0) (names #f) (nnames 0))
    (define (ensure! n)
      (when (fx> (fx+ pos n) (bytevector-length buf))
        (let ((nb (make-bytevector (fxmax (fx* 2 (bytevector-length buf)) (fx+ pos n)))))
          (bytevector-copy! buf 0 nb 0 pos)
          (set! buf nb))))
    (define (u8! b)
      (ensure! 1) (bytevector-u8-set! buf pos b) (set! pos (fx+ pos 1)))
    ;; unsigned varint of a non-negative exact integer below 2^64
    (define (uvar! n)
      (ensure! 10)
      (if (fixnum? n)
          (let loop ((n n))
            (if (fx< n 128)
                (begin (bytevector-u8-set! buf pos n) (set! pos (fx+ pos 1)))
                (begin (bytevector-u8-set! buf pos (fxior 128 (fxand n 127)))
                       (set! pos (fx+ pos 1))
                       (loop (fxsrl n 7)))))
          (let loop ((n n))
            (if (< n 128)
                (begin (bytevector-u8-set! buf pos n) (set! pos (fx+ pos 1)))
                (begin (bytevector-u8-set! buf pos (fxior 128 (logand n 127)))
                       (set! pos (fx+ pos 1))
                       (loop (bitwise-arithmetic-shift-right n 7)))))))
    (define (zigzag n) (if (>= n 0) (* 2 n) (- (* -2 n) 1)))
    (define (int! n)
      (if (and (>= n -9223372036854775808) (< n 9223372036854775808))
          (begin (u8! 3) (uvar! (zigzag n)))
          (let* ((m (abs n)) (len (fxquotient (fx+ (bitwise-length m) 7) 8)))
            (u8! 4) (u8! (if (< n 0) 1 0)) (uvar! len) (ensure! len)
            (let loop ((i (fx- len 1)) (m m))
              (when (fx>= i 0)
                (bytevector-u8-set! buf (fx+ pos i) (logand m 255))
                (loop (fx- i 1) (bitwise-arithmetic-shift-right m 8))))
            (set! pos (fx+ pos len)))))
    ;; Chez's string->utf8 (compiled into the boot files, unlike this file, which eval compiles
    ;; in safe mode) is about twice as fast as a per-char loop here
    (define (str! s)
      (let* ((bv (string->utf8 s)) (len (bytevector-length bv)))
        (uvar! len) (ensure! len)
        (bytevector-copy! bv 0 buf pos len)
        (set! pos (fx+ pos len))))
    ;; the name reference for object o (eq?): #f when it was new (caller writes it), else written
    (define (name-ref! o)
      (unless names (set! names (make-eq-hashtable)))
      (let ((i (hashtable-ref names o #f)))
        (if i
            (begin (uvar! (fx+ i 1)) #t)
            (begin (hashtable-set! names o nnames) (set! nnames (fx+ nnames 1)) (uvar! 0) #f))))
    (define (ns+name! ns name)
      (if (and ns (not (jolt-nil? ns)))
          (begin (u8! 1) (str! ns))
          (u8! 0))
      (str! name))
    (define (meta! m)
      (when (and m (not (jolt-nil? m)) (fx> (jolt-count m) 0))
        (u8! 28) (w m)))
    (define (seq! s)
      (u8! 20)
      (let loop ((s (jolt-seq s)))
        (unless (jolt-nil? s)
          (w (seq-first s))
          (loop (seq-more s))))
      (u8! 21))
    (define (rec! x)
      (let* ((d (jrec-desc x)) (tag (jrdesc-tag d)) (h (hashtable-ref kjc-handlers tag #f)))
        (u8! (if h 27 26))
        (if h
            (begin (unless (name-ref! d) (str! tag)) (w ((car h) x)))
            (let ((n (jrec-nfields x)))
              (unless (name-ref! d) (str! tag) (uvar! n))
              (let loop ((i 0))
                (when (fx< i n) (w (jrec-field-ref x i)) (loop (fx+ i 1))))
              (w (jrec-ext x))))))
    (define (w x)
      (cond
        ((fixnum? x) (int! x))
        ((string? x) (u8! 10) (str! x))
        ((keyword-t? x)
         (u8! 11)
         (unless (name-ref! x) (ns+name! (keyword-t-ns x) (keyword-t-name x))))
        ((eq? x #t) (u8! 1))
        ((eq? x #f) (u8! 2))
        ((jolt-nil-t? x) (u8! 0))
        ((pvec? x)
         (meta! (pvec-meta x))
         (let ((n (pvec-cnt x)))
           (if (eq? (pvec-ent x) #t)
               (u8! 16)
               (begin (u8! 15) (uvar! n)))
           (let loop ((i 0))
             (when (fx< i n)
               (let-values (((chunk off) (pv-leaf-for x i)))
                 (let ((run (fxmin (fx- (vector-length chunk) off) (fx- n i))))
                   (let cloop ((j 0))
                     (when (fx< j run) (w (vector-ref chunk (fx+ off j))) (cloop (fx+ j 1))))
                   (loop (fx+ i run))))))))
        ((pmap? x)
         (meta! (pmap-meta x))
         (u8! (if (pmap-array? x) 17 18))
         (uvar! (pmap-cnt x))
         (pmap-fold-fwd x (lambda (k v acc) (w k) (w v) acc) #f))
        ((jrec? x) (rec! x))
        ((flonum? x)
         (u8! 5) (ensure! 8)
         (bytevector-ieee-double-set! buf pos x (endianness big))
         (set! pos (fx+ pos 8)))
        ((pset? x)
         (meta! (pset-meta x))
         (u8! 19) (uvar! (pset-count x))
         (pset-fold x (lambda (e acc) (w e) acc) #f))
        ((cseq? x) (meta! (cseq-meta x)) (seq! x))
        ((empty-list-t? x) (meta! (empty-list-t-meta x)) (u8! 20) (u8! 21))
        ((jolt-lazyseq? x) (seq! x))
        ((symbol-t? x)
         (let ((m (symbol-t-meta x)))
           (if (and m (not (jolt-nil? m)))
               ;; a symbol with metadata is written as a new name each time (its index is never repeated)
               (begin (meta! m) (u8! 13) (uvar! 0) (set! nnames (fx+ nnames 1))
                      (ns+name! (symbol-t-ns x) (symbol-t-name x)))
               (begin
                 (u8! 13)
                 (unless (name-ref! x) (ns+name! (symbol-t-ns x) (symbol-t-name x)))))))
        ((juuid? x)
         (u8! 22) (ensure! 16)
         (bytevector-u64-set! buf pos (juuid-msb x) (endianness big))
         (bytevector-u64-set! buf (fx+ pos 8) (juuid-lsb x) (endianness big))
         (set! pos (fx+ pos 16)))
        ((and (number? x) (exact? x))
         (if (integer? x) (int! x) (begin (u8! 7) (w (numerator x)) (w (denominator x)))))
        ((char? x) (u8! 9) (uvar! (char->integer x)))
        ((jinst? x) (u8! 23) (uvar! (zigzag (jinst-ms x))))
        ((jtagged? x) (u8! 24) (w (jtagged-tag x)) (w (jtagged-form x)))
        ((jfloat? x)
         (u8! 6) (ensure! 4)
         (bytevector-ieee-single-set! buf pos (jfloat-fl x) (endianness big))
         (set! pos (fx+ pos 4)))
        ((jbigdec? x) (u8! 8) (w (jbigdec-unscaled x)) (w (jbigdec-scale x)))
        ((and (jolt-array? x) (eq? (jolt-array-kind x) 'byte))
         (let* ((bv (jolt-array-vec x)) (n (bytevector-length bv)))
           (u8! 25) (uvar! n) (ensure! n)
           (bytevector-copy! bv 0 buf pos n)
           (set! pos (fx+ pos n))))
        (else (kjc-no-encoding x))))
    (u8! #x4A) (u8! kjc-version)
    (w v)
    (bytevector-truncate! buf pos)
    buf))

(define kjc-hex "0123456789abcdef")
;; the juuid record's own field constructor (s msb lsb): the halves are read from the bytes,
;; not parsed back out of the string the protocol constructor would take
(define kjc-make-juuid
  (record-constructor (make-record-constructor-descriptor (record-type-descriptor juuid) #f #f)))
(define (kjc-uuid bv at)
  (let ((s (make-string 36 #\-)))
    (define (hex! b i)
      (let ((x (bytevector-u8-ref bv (fx+ at b))))
        (string-set! s i (string-ref kjc-hex (fxsrl x 4)))
        (string-set! s (fx+ i 1) (string-ref kjc-hex (fxand x 15)))))
    (hex! 0 0) (hex! 1 2) (hex! 2 4) (hex! 3 6) (hex! 4 9) (hex! 5 11) (hex! 6 14) (hex! 7 16)
    (hex! 8 19) (hex! 9 21) (hex! 10 24) (hex! 11 26) (hex! 12 28) (hex! 13 30) (hex! 14 32) (hex! 15 34)
    (kjc-make-juuid s (bytevector-u64-ref bv at (endianness big)) (bytevector-u64-ref bv (fx+ at 8) (endianness big)))))

(define (kjc-decode bv)
  (let ((pos 0) (names (make-vector 16)) (nnames 0))
    (define (u8)
      (let ((b (bytevector-u8-ref bv pos))) (set! pos (fx+ pos 1)) b))
    (define (uvar)
      (let loop ((acc 0) (shift 0))
        (let ((b (u8)))
          (let ((acc (if (fx< shift 56)
                         (fxior acc (fxsll (fxand b 127) shift))
                         (+ acc (bitwise-arithmetic-shift-left (fxand b 127) shift)))))
            (if (fx< b 128) acc (loop acc (fx+ shift 7)))))))
    (define (unzigzag z) (if (even? z) (quotient z 2) (- (quotient (+ z 1) 2))))
    (define (str)
      (let* ((n (uvar)) (t (make-bytevector n)))
        (bytevector-copy! bv pos t 0 n)
        (set! pos (fx+ pos n))
        (utf8->string t)))
    (define (add-name! o)
      (when (fx= nnames (vector-length names))
        (let ((nv (make-vector (fx* 2 nnames))))
          (let loop ((i 0)) (when (fx< i nnames) (vector-set! nv i (vector-ref names i)) (loop (fx+ i 1))))
          (set! names nv)))
      (vector-set! names nnames o)
      (set! nnames (fx+ nnames 1))
      o)
    (define (ns+name)
      (let* ((ns (if (fx= (u8) 1) (str) #f)) (name (str))) (values ns name)))
    (define (ref i) (vector-ref names (fx- i 1)))
    (define (rd-vector n)
      (let ((v (make-vector n)))
        (let loop ((i 0)) (when (fx< i n) (vector-set! v i (r)) (loop (fx+ i 1))))
        v))
    ;; fields are read in declared order, then the extension map; the per-arity native
    ;; constructor (make-jrec would spread a vector through apply)
    (define (rd-jrec d n)
      (if (fx> n 8)
          (let* ((vals (rd-vector n)) (ext (r))) (make-jrec* d ext 0 vals))
          (let ((mk (vector-ref jrec-ctor-vec n)))
            (case n
              ((0) (mk d (r) 0))
              ((1) (let* ((a (r)) (ext (r))) (mk d ext 0 a)))
              ((2) (let* ((a (r)) (b (r)) (ext (r))) (mk d ext 0 a b)))
              ((3) (let* ((a (r)) (b (r)) (c (r)) (ext (r))) (mk d ext 0 a b c)))
              ((4) (let* ((a (r)) (b (r)) (c (r)) (e (r)) (ext (r))) (mk d ext 0 a b c e)))
              ((5) (let* ((a (r)) (b (r)) (c (r)) (e (r)) (f (r)) (ext (r))) (mk d ext 0 a b c e f)))
              ((6) (let* ((a (r)) (b (r)) (c (r)) (e (r)) (f (r)) (g (r)) (ext (r))) (mk d ext 0 a b c e f g)))
              ((7) (let* ((a (r)) (b (r)) (c (r)) (e (r)) (f (r)) (g (r)) (h (r)) (ext (r))) (mk d ext 0 a b c e f g h)))
              (else (let* ((a (r)) (b (r)) (c (r)) (e (r)) (f (r)) (g (r)) (h (r)) (i (r)) (ext (r))) (mk d ext 0 a b c e f g h i)))))))
    (define (r)
      (let ((t (u8)))
        (case t
          ((0) jolt-nil)
          ((1) #t)
          ((2) #f)
          ((3) (unzigzag (uvar)))
          ((4) (let* ((neg (fx= (u8) 1)) (len (uvar)))
                 (let loop ((i 0) (m 0))
                   (if (fx= i len)
                       (if neg (- m) m)
                       (loop (fx+ i 1) (+ (* m 256) (u8)))))))
          ((5) (let ((x (bytevector-ieee-double-ref bv pos (endianness big)))) (set! pos (fx+ pos 8)) x))
          ((6) (let ((x (bytevector-ieee-single-ref bv pos (endianness big)))) (set! pos (fx+ pos 4)) (make-jfloat x)))
          ((7) (let* ((n (r)) (d (r))) (/ n d)))
          ((8) (let* ((u (r)) (s (r))) (make-jbigdec u s)))
          ((9) (integer->char (uvar)))
          ((10) (str))
          ((11) (let ((i (uvar)))
                  (if (fx= i 0) (let-values (((ns name) (ns+name))) (add-name! (keyword ns name))) (ref i))))
          ((13) (let ((i (uvar)))
                  (if (fx= i 0) (let-values (((ns name) (ns+name))) (add-name! (jolt-symbol ns name))) (ref i))))
          ((15) (make-pvec (rd-vector (uvar))))
          ((16) (let* ((k (r)) (v (r))) (make-map-entry k v)))
          ((17) (let ((n (uvar)))
                  (if (fx= n 0) empty-pmap (amap-slots->pmap (rd-vector (fx* 2 n))))))
          ((18) (let ((n (uvar)) (t (jolt-transient-new empty-pmap-hash)))
                  (let loop ((i 0))
                    (when (fx< i n) (let* ((k (r)) (v (r))) (tmap-put! t k v)) (loop (fx+ i 1))))
                  (jolt-persistent! t)))
          ((19) (let ((n (uvar)) (t (jolt-transient-new empty-pmap-hash)))
                  (let loop ((i 0))
                    (when (fx< i n) (let ((e (r))) (tmap-put! t e e)) (loop (fx+ i 1))))
                  (make-pset (jolt-persistent! t))))
          ((20) (let loop ((acc '()))
                  (if (fx= (bytevector-u8-ref bv pos) 21)
                      (begin
                        (set! pos (fx+ pos 1))
                        (if (null? acc)
                            jolt-empty-list
                            (let ((xs (reverse acc)))
                              (cseq-list (car xs) (list->cseq/k (cdr xs) sk-list)))))
                      (loop (cons (r) acc)))))
          ((22) (let ((u (kjc-uuid bv pos))) (set! pos (fx+ pos 16)) u))
          ((23) (make-jinst (unzigzag (uvar))))
          ((24) (let* ((tag (r)) (form (r))) (make-jtagged tag form)))
          ((25) (let* ((n (uvar)) (b (make-bytevector n)))
                  (bytevector-copy! bv pos b 0 n)
                  (set! pos (fx+ pos n))
                  (make-jolt-array b 'byte)))
          ((26) (let* ((i (uvar))
                       (d (if (fx= i 0)
                              (let* ((tag (str)) (n (uvar))
                                     (d (or (hashtable-ref chez-tag-desc tag #f)
                                            (error 'konserve.jolt.fasl "no live type for tag" tag))))
                                (unless (fx= n (jrdesc-nfields d))
                                  (error 'konserve.jolt.fasl "the stored type's field count differs from the live type's"
                                         tag n (jrdesc-nfields d)))
                                (add-name! d))
                              (ref i))))
                  (rd-jrec d (jrdesc-nfields d))))
          ((27) (let* ((i (uvar))
                       (h (if (fx= i 0)
                              (let ((tag (str)))
                                (add-name! (or (hashtable-ref kjc-handlers tag #f)
                                               (error 'konserve.jolt.fasl "no handler registered for tag" tag))))
                              (ref i))))
                  ((cdr h) (r))))
          ((28) (let* ((m (r)) (x (r))) (jolt-with-meta x m)))
          (else (error 'konserve.jolt.fasl "unknown tag byte" t (fx- pos 1))))))
    (unless (and (fx>= (bytevector-length bv) 2)
                 (fx= (bytevector-u8-ref bv 0) #x4A)
                 (fx= (bytevector-u8-ref bv 1) kjc-version))
      (error 'konserve.jolt.fasl "not jfasl version 1 bytes"
             (if (fx>= (bytevector-length bv) 2)
                 (list (bytevector-u8-ref bv 0) (bytevector-u8-ref bv 1))
                 (bytevector-length bv))))
    (set! pos 2)
    (r)))

;; byte-array (jolt-array of kind byte, backed by a bytevector) <-> bytevector, no copy
(define (kjc-bv->ba bv) (make-jolt-array bv 'byte))
(define (kjc-ba->bv a) (jolt-array-vec a))
