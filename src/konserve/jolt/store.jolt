(ns konserve.jolt.store
  "Registers the LMDB backend with konserve.store's dispatch: requiring this
  namespace adds {:backend :lmdb :path ..} over konserve.jolt.lmdb. (:file is
  konserve.store's own on Jolt, over konserve.jolt.filestore.)"
  (:require [konserve.store :as ks]
            [konserve.jolt.filestore :as jfs]
            [konserve.jolt.lmdb :as lmdb]
            [konserve.jolt.posix :as p]
            [superv.async :refer [go-try-]]))

(defn- answer [opts v] (if (:sync? opts) v (go-try- v)))

;; ----- :lmdb -----

(defn- lmdb-opts [config opts]
  (cond-> (jfs/store-opts config opts)
    (:lmdb config) (assoc :lmdb (:lmdb config))))

(defmethod ks/-connect-store :lmdb [{:keys [path] :as config} opts]
  (when-not (p/exists? (str path "/data.mdb"))
    (throw (ex-info (str "LMDB store does not exist at path: " path) {:path path :config config})))
  (apply lmdb/connect-lmdb-store path (mapcat identity (lmdb-opts config opts))))

(defmethod ks/-create-store :lmdb [{:keys [path] :as config} opts]
  (when (p/exists? (str path "/data.mdb"))
    (throw (ex-info (str "LMDB store already exists at path: " path) {:path path :config config})))
  (apply lmdb/connect-lmdb-store path (mapcat identity (lmdb-opts config opts))))

(defmethod ks/-store-exists? :lmdb [{:keys [path]} opts]
  (answer opts (p/exists? (str path "/data.mdb"))))

(defmethod ks/-delete-store :lmdb [{:keys [path]} opts]
  (lmdb/close-env! path)
  (answer opts (jfs/delete-store path)))

(defmethod ks/-release-store :lmdb [{:keys [path]} _ opts] (lmdb/release-env! path) (answer opts nil))
