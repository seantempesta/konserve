(ns konserve.jolt.lmdb-ffi
  "Minimal LMDB binding over jolt.ffi: one env, the unnamed database, write
  transactions run start-to-commit inside one call, read transactions MDB_NOTLS
  so any thread (go blocks, fibers) can run them. Values are copied out of the
  map before the read transaction ends."
  (:require [jolt.ffi :as ffi]))

(def lib-path
  (or (System/getenv "JOLT_LMDB_LIB")
      (str (System/getProperty "user.home") "/src/seon-jolt/vendor-c/lmdb/libraries/liblmdb/liblmdb.dylib")))

(ffi/load-library lib-path)

(def MDB_NOSUBDIR 0x4000)
(def MDB_NOSYNC 0x10000)
(def MDB_RDONLY 0x20000)
(def MDB_NOMETASYNC 0x40000)
(def MDB_WRITEMAP 0x80000)
(def MDB_NOTLS 0x200000)
(def MDB_NORDAHEAD 0x800000)
(def MDB_CREATE 0x40000)
(def MDB_NEXT 8)
(def MDB_NOTFOUND -30798)

(ffi/defcfn mdb-env-create "mdb_env_create" [:pointer] :int)
(ffi/defcfn mdb-env-set-mapsize "mdb_env_set_mapsize" [:pointer :size_t] :int)
(ffi/defcfn mdb-env-set-maxreaders "mdb_env_set_maxreaders" [:pointer :uint] :int)
(ffi/defcfn mdb-env-set-syncpages "mdb_env_set_syncpages" [:pointer :size_t] :int)
(ffi/defcfn mdb-env-info "mdb_env_info" [:pointer :pointer] :int)
(ffi/defcfn mdb-env-steady-txn "mdb_env_steady_txn" [:pointer :pointer] :int)
(ffi/defcfn mdb-env-open "mdb_env_open" [:pointer :string :uint :int] :int)
(ffi/defcfn mdb-env-close "mdb_env_close" [:pointer] :void)
(ffi/defcfn mdb-env-sync "mdb_env_sync" [:pointer :int] :int {:blocking true})
(ffi/defcfn mdb-txn-begin "mdb_txn_begin" [:pointer :pointer :uint :pointer] :int {:blocking true})
(ffi/defcfn mdb-txn-commit "mdb_txn_commit" [:pointer] :int {:blocking true})
(ffi/defcfn mdb-txn-abort "mdb_txn_abort" [:pointer] :void)
(ffi/defcfn mdb-dbi-open "mdb_dbi_open" [:pointer :string :uint :pointer] :int)
(ffi/defcfn mdb-get "mdb_get" [:pointer :uint :pointer :pointer] :int)
(ffi/defcfn mdb-put "mdb_put" [:pointer :uint :pointer :pointer :uint] :int)
(ffi/defcfn mdb-del "mdb_del" [:pointer :uint :pointer :pointer] :int)
(ffi/defcfn mdb-cursor-open "mdb_cursor_open" [:pointer :uint :pointer] :int)
(ffi/defcfn mdb-cursor-get "mdb_cursor_get" [:pointer :pointer :pointer :int] :int)
(ffi/defcfn mdb-cursor-close "mdb_cursor_close" [:pointer] :void)
(ffi/defcfn mdb-strerror "mdb_strerror" [:int] :string)
(ffi/defcfn mdb-env-copy2 "mdb_env_copy2" [:pointer :pointer :uint] :int {:blocking true})
(def MDB_CP_COMPACT 1)

(defn- check [op rc]
  (when-not (zero? rc)
    (throw (ex-info (str "lmdb " op ": " (mdb-strerror rc)) {:op op :rc rc :type :lmdb-error})))
  rc)

(def MDB_ALONE 0x1000)
(def MDB_ENV_BUSY -30771)

(defn close-env
  "Close the env under its exclusive write lock so all in-flight read/write txns and
  adopt-mapsize! calls drain before munmap/mdb_env_close. Idempotent on double close."
  [{:keys [env open? rw-lock]}]
  (let [^java.util.concurrent.locks.ReentrantReadWriteLock rw rw-lock
        wl (when rw (.writeLock rw))]
    (when wl (.lock wl))
    (try
      (when @open?
        (reset! open? false)
        (mdb-env-close env))
      (finally (when wl (.unlock wl))))))

(defn- live-env
  "The env pointer of db, or the typed error when its env was closed (close-env): the store
  was released or deleted, and its values are read before that."
  [{:keys [env open? path]}]
  (when-not @open?
    (throw (ex-info (str "lmdb env closed: " path " (its store was released; read a value before its last release)")
                    {:type :lmdb-env-closed :path path})))
  env)

(defn- begin [env flags]
  (let [pp (ffi/alloc :pointer)]
    (try (check "txn_begin" (mdb-txn-begin env ffi/null flags pp))
         (ffi/read pp :pointer)
         (finally (ffi/free pp)))))

;; MDB_val {size_t mv_size; void *mv_data}
(defn- set-val! [v size data] (ffi/write v :size_t size 0) (ffi/write v :pointer data 8))
(defn- val-size [v] (ffi/read v :size_t 0))
(defn- val-data [v] (ffi/read v :pointer 8))

(defn- with-key [^String k f]
  (let [kb (.getBytes k "UTF-8")
        n (alength kb)
        buf (ffi/alloc (+ 32 n))
        kv buf
        dv (+ buf 16)
        kdata (+ buf 32)]
    (try
      (ffi/write-array kdata kb)
      (set-val! kv n kdata)
      (f kv dv)
      (finally (ffi/free buf)))))

(def ^:dynamic *txn*
  "The write transaction `transact` holds on this thread, or nil: inside it every read-txn
  and write-txn of this thread runs in it, so they commit or abort together."
  nil)

(defn- commit-or-abort [txn f]
  (let [committed? (volatile! false)]
    (try
      (let [r (f txn)]
        (vreset! committed? true)
        (check "txn_commit" (mdb-txn-commit txn))
        r)
      (catch Throwable e
        ;; mdb_txn_commit always ends and frees txn even on failure (mdb.c _mdb_txn_commit).
        (when-not @committed?
          (mdb-txn-abort txn))
        (throw e)))))

(defn get-bytes
  "Value bytes for key k in txn, or nil."
  [{:keys [dbi]} txn k]
  (with-key k
    (fn [kv dv]
      (let [rc (mdb-get txn dbi kv dv)]
        (cond
          (= rc MDB_NOTFOUND) nil
          :else (do (check "get" rc)
                    (let [n (val-size dv)]
                      (if (zero? n) (byte-array 0) (ffi/read-array (val-data dv) n)))))))))

;; what a reader of a value's metadata takes: the head of the value, never the rest of it
(defn get-prefix
  "The first bytes of key k's value in txn, or nil: (want head) of them, head being its first
  h bytes (fewer when the value is shorter), never more than the value holds. The bytes are
  copied out of the map; the rest of the value is not touched."
  [{:keys [dbi]} txn k h want]
  (with-key k
    (fn [kv dv]
      (let [rc (mdb-get txn dbi kv dv)]
        (cond
          (= rc MDB_NOTFOUND) nil
          :else (do (check "get" rc)
                    (let [size (val-size dv) p (val-data dv)
                          head (if (zero? size) (byte-array 0) (ffi/read-array p (min h size)))
                          n (min size (long (want head)))]
                      (if (<= n (alength ^bytes head)) head (ffi/read-array p n)))))))))

(defn exists-in? [{:keys [dbi]} txn k]
  (with-key k (fn [kv dv] (let [rc (mdb-get txn dbi kv dv)]
                            (if (= rc MDB_NOTFOUND) false (do (check "get" rc) true))))))

(defn put-bytes! [{:keys [dbi]} txn k ^bytes v]
  (with-key k
    (fn [kv dv]
      (let [n (alength v)
            vb (ffi/alloc (max 1 n))]
        (try
          (ffi/write-array vb v)
          (set-val! dv n vb)
          (check "put" (mdb-put txn dbi kv dv 0))
          (finally (ffi/free vb)))))))

(defn put-parts!
  "Put parts (byte-arrays) under key k in txn as one value, their bytes written in order into the value's
  buffer: what put-bytes! of their concatenation writes, without the concatenated copy."
  [{:keys [dbi]} txn k parts]
  (with-key k
    (fn [kv dv]
      (let [n (reduce + 0 (map #(alength ^bytes %) parts))
            vb (ffi/alloc (max 1 n))]
        (try
          (reduce (fn [at ^bytes p] (ffi/write-array (+ vb at) p) (+ at (alength p))) 0 parts)
          (set-val! dv n vb)
          (check "put" (mdb-put txn dbi kv dv 0))
          (finally (ffi/free vb)))))))

(defn del! [{:keys [dbi]} txn k]
  (with-key k (fn [kv _] (let [rc (mdb-del txn dbi kv ffi/null)]
                           (if (= rc MDB_NOTFOUND) false (do (check "del" rc) true))))))

(defn all-keys
  "Every key in the database, as strings."
  [{:keys [dbi]} txn]
  (let [buf (ffi/alloc 48)
        cp buf kv (+ buf 16) dv (+ buf 32)]
    (try
      (check "cursor_open" (mdb-cursor-open txn dbi cp))
      (let [cur (ffi/read cp :pointer)]
        (try
          (loop [acc (transient [])]
            (let [rc (mdb-cursor-get cur kv dv MDB_NEXT)]
              (if (= rc MDB_NOTFOUND)
                (persistent! acc)
                (do (check "cursor_get" rc)
                    (recur (conj! acc (String. ^bytes (ffi/read-array (val-data kv) (val-size kv)) "UTF-8")))))))
          (finally (mdb-cursor-close cur))))
      (finally (ffi/free buf)))))

(defn sync! [db] (check "env_sync" (mdb-env-sync (live-env db) 1)))

(defn env-info
  "The env's state, mdb_env_info and mdb_env_steady_txn: {:map-bytes :last-page :last-txn :steady-txn :max-readers
  :readers}. :last-page + 1 is the pages the file uses; :last-txn less :steady-txn, the commits an OS crash would
  lose, whose freed pages are held from reuse (MDB_SAFENOSYNC); :steady-txn 0 when the env has made no steady point."
  [db]
  ;; MDB_envinfo: void *me_mapaddr; mdb_size_t me_mapsize, me_last_pgno, me_last_txnid; unsigned me_maxreaders, me_numreaders
  (let [env (live-env db)
        p (ffi/alloc 56)]
    (try
      (check "env_info" (mdb-env-info env p))
      (check "env_steady_txn" (mdb-env-steady-txn env (+ p 48)))
      {:map-bytes (ffi/read p :size_t 8) :last-page (ffi/read p :size_t 16) :last-txn (ffi/read p :size_t 24)
       :steady-txn (ffi/read p :size_t 48) :max-readers (ffi/read p :uint32 32) :readers (ffi/read p :uint32 36)}
      (finally (ffi/free p)))))

(defn compact-copy!
  "Write a compacted copy of the env to directory dst (which must exist and hold no
  data.mdb): mdb_env_copy2 with MDB_CP_COMPACT, which writes only the pages in use, in
  order, so freed pages (a sweep's deletions) leave the file. The copy reads one
  snapshot: commits made while it runs are not in it. nil."
  [db ^String dst]
  (let [p (ffi/string->ptr dst)]
    (try (check "env_copy2" (mdb-env-copy2 (live-env db) p MDB_CP_COMPACT))
         (finally (ffi/free p)))))

(def MDB_MAP_FULL -30792)
(def MDB_MAP_RESIZED -30785)

(defn- env-map-bytes [env]
  (let [p (ffi/alloc 56)]
    (try
      (check "env_info" (mdb-env-info env p))
      (ffi/read p :size_t 8)
      (finally (ffi/free p)))))

(defn open-env
  "Open (creating) the env directory `path`. Answers {:env ptr :dbi n :path :open? :rw-lock}, :open? an atom
  close-env sets false. :sync-pages bounds the pages this process's commits free before one of them
  makes a steady point itself (mdb_env_set_syncpages, our LMDB's MDB_SAFENOSYNC); none when absent.
  :map-size sizes a new store and monotonically grows an existing writable store when larger than its
  recorded map size (never shrinking an existing store). With MDB_ALONE in :flags the open is refused,
  {:type :lmdb-not-alone}, while another process holds the store."
  [path {:keys [map-size max-readers flags sync-pages] :or {map-size (* 1024 1024 1024) max-readers 126 flags 0}}]
  (let [pp (ffi/alloc :pointer)
        exists? (.exists (java.io.File. (str path "/data.mdb")))
        rdonly? (pos? (bit-and flags MDB_RDONLY))]
    (try
      (check "env_create" (mdb-env-create pp))
      (let [env (ffi/read pp :pointer)]
        ;; LMDB adopts the size the store records when none is set (mdb_env_open2): a new store takes ours,
        ;; and an existing store opens at its recorded size first so a smaller caller never shrinks it.
        (when-not exists?
          (check "env_set_mapsize" (mdb-env-set-mapsize env map-size)))
        (check "env_set_maxreaders" (mdb-env-set-maxreaders env max-readers))
        (when sync-pages (check "env_set_syncpages" (mdb-env-set-syncpages env sync-pages)))
        (let [rc (mdb-env-open env path (bit-or MDB_NOTLS flags) 0664)]
          (when-not (zero? rc)
            (mdb-env-close env)
            (if (= rc MDB_ENV_BUSY)
              (throw (ex-info (str "lmdb env_open " path ": another process holds the store") {:type :lmdb-not-alone :path path :rc rc}))
              (check "env_open" rc))))
        ;; Post-open setup: on any failure, abort any open txn and close env so handles/reader slots never leak.
        (let [txn-v (volatile! nil)]
          (try
            ;; Monotonically grow an existing writable store's map when requested :map-size exceeds its recorded size.
            ;; Safe here: open-env runs under lmdb/envs lock before DBI open, so zero txns exist yet.
            (when (and exists? (not rdonly?) map-size (> (long map-size) (long (env-map-bytes env))))
              (check "env_set_mapsize" (mdb-env-set-mapsize env (long map-size))))
            ;; the main dbi opens in a read txn on a read-only env (a write txn is MDB_IS_READONLY there)
            (check "txn_begin" (mdb-txn-begin env ffi/null (bit-and flags MDB_RDONLY) pp))
            (let [txn (ffi/read pp :pointer)
                  _ (vreset! txn-v txn)
                  dp (ffi/alloc :uint32)]
              (try
                (check "dbi_open" (mdb-dbi-open txn nil 0 dp))
                (let [dbi (ffi/read dp :uint32)]
                  (vreset! txn-v nil)
                  (check "txn_commit" (mdb-txn-commit txn))
                  {:env env :dbi dbi :path path :open? (atom true)
                   :rw-lock (java.util.concurrent.locks.ReentrantReadWriteLock.)})
                (finally (ffi/free dp))))
            (catch Throwable e
              (when-let [t @txn-v] (mdb-txn-abort t))
              (mdb-env-close env)
              (throw e)))))
      (finally (ffi/free pp)))))

(defn begin-raw
  "Calls mdb_txn_begin and returns [rc txn-ptr-or-nil] without throwing."
  [env flags]
  (let [pp (ffi/alloc :pointer)]
    (try
      (let [rc (mdb-txn-begin env ffi/null flags pp)]
        [rc (when (zero? rc) (ffi/read pp :pointer))])
      (finally (ffi/free pp)))))

(defn adopt-mapsize-unlocked!
  "Adopts the store's grown map size via mdb_env_set_mapsize(env, 0). Caller MUST hold (:rw-lock db)'s write lock."
  [db]
  (check "env_set_mapsize" (mdb-env-set-mapsize (live-env db) 0)))

(defn adopt-mapsize!
  "Acquires db's exclusive write lock (draining all local read/write txns so munmap is safe) and
  adopts the store's grown map size via mdb_env_set_mapsize(env, 0)."
  [db]
  (let [^java.util.concurrent.locks.ReentrantReadWriteLock rw (:rw-lock db)
        wl (when rw (.writeLock rw))]
    (when wl (.lock wl))
    (try
      (adopt-mapsize-unlocked! db)
      (finally (when wl (.unlock wl))))))

(defn- begin-locked [db flags]
  (let [^java.util.concurrent.locks.ReentrantReadWriteLock rw (:rw-lock db)
        rl (when rw (.readLock rw))]
    (loop [tries 0]
      (when rl (.lock rl))
      (let [res (try
                  (let [[rc txn] (begin-raw (live-env db) flags)]
                    (cond
                      (zero? rc) [rl txn]
                      (and (= rc MDB_MAP_RESIZED) (< tries 2) rw (= 1 (.getReadHoldCount rw))) :resized
                      :else (do (check "txn_begin" rc) [rl txn])))
                  (catch Throwable e
                    (when rl (.unlock rl))
                    (throw e)))]
        (if (= :resized res)
          (do (when rl (.unlock rl))
              (adopt-mapsize! db)
              (recur (inc tries)))
          res)))))

(defn- map-full? [e]
  (let [d (ex-data e)]
    (and (= :lmdb-error (:type d))
         (= MDB_MAP_FULL (:rc d)))))

(defn- align-page ^long [^long n]
  ;; 16 KiB covers both 4 KiB (x86_64/Linux) and 16 KiB (Apple Silicon macOS).
  (let [pg 16384]
    (* (quot (+ n (dec pg)) pg) pg)))

(defn grow-mapsize!
  "Acquires db's exclusive write lock (draining all local read/write txns so munmap is safe)
  and grows the LMDB map size past `seen-bytes` (doubling, at least +1 MiB, 16 KiB aligned).
  First adopts any larger size another process may already have committed via mdb_env_set_mapsize(env, 0).
  Returns the new map size in bytes."
  [db ^long seen-bytes]
  (let [^java.util.concurrent.locks.ReentrantReadWriteLock rw (:rw-lock db)
        wl (when rw (.writeLock rw))]
    (when wl (.lock wl))
    (try
      (let [env (live-env db)
            before (long (env-map-bytes env))]
        (if (> before seen-bytes)
          before
          (do
            (adopt-mapsize-unlocked! db)
            (let [adopted (long (env-map-bytes env))]
              (if (> adopted seen-bytes)
                adopted
                (let [base (max before adopted seen-bytes)
                      target (align-page (max (* 2 base) (+ base (* 1024 1024))))]
                  (check "env_set_mapsize" (mdb-env-set-mapsize env target))
                  (long (env-map-bytes env))))))))
      (finally (when wl (.unlock wl))))))

(defn- run-write-txn [db f]
  (let [^java.util.concurrent.locks.ReentrantReadWriteLock rw (:rw-lock db)]
    (loop [grows 0]
      (let [[rl txn] (begin-locked db 0)
            seen (long (env-map-bytes (live-env db)))
            res (try
                  [:ok (commit-or-abort txn f)]
                  (catch Throwable e
                    (if (and (map-full? e)
                             (< grows 16)
                             (or (nil? rw) (= 1 (.getReadHoldCount rw))))
                      [:full seen]
                      (throw e)))
                  (finally (when rl (.unlock rl))))]
        (if (= :full (nth res 0))
          (do (grow-mapsize! db (nth res 1))
              (recur (inc grows)))
          (nth res 1))))))

(defn transact
  "Run (f) with every read-txn and write-txn of this thread inside one write transaction:
  committed when f returns, aborted when it throws. Automatically grows the LMDB map size on
  MDB_MAP_FULL and retries. LMDB has one writer per env across processes, so nothing interleaves
  with it. Answers f's value."
  [db f]
  (if *txn*
    (f)
    (run-write-txn db (fn [t] (binding [*txn* t] (f))))))

(defn write-txn
  "Run (f txn) in a write transaction and commit it; abort on exception. Automatically grows
  the LMDB map size on MDB_MAP_FULL and retries. Inside `transact`, f runs in its transaction,
  which commits when `transact` ends."
  [db f]
  (if-some [t *txn*]
    (f t)
    (run-write-txn db f)))

(defn read-txn
  "Run (f txn) in a read-only transaction (in `transact`'s, when one is open)."
  [db f]
  (if-some [t *txn*]
    (f t)
    (let [[rl txn] (begin-locked db MDB_RDONLY)]
      (try (f txn)
           (finally
             (try (mdb-txn-abort txn)
                  (finally (when rl (.unlock rl)))))))))
